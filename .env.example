# Existing Supabase project: Coding Club (wfmzhrjdjbkuezsmewjk)
SUPABASE_URL=https://wfmzhrjdjbkuezsmewjk.supabase.co
NODE_ENV=development
PORT=4000
# From Supabase > Project Settings > Database > Connection string > Session pooler
DATABASE_URL=postgresql://postgres.wfmzhrjdjbkuezsmewjk:YOUR_URL_ENCODED_PASSWORD@YOUR_SUPABASE_POOLER_HOST.pooler.supabase.com:5432/postgres
JWT_SECRET=replace-with-64-random-characters
CORS_ORIGINS=http://localhost:5173
# Notification provider (Resend), leave unset to queue without sending
RESEND_API_KEY=
MAIL_REPLY_TO=codingclub@gecazamgarh.ac.in
MAIL_FROM=
# Needed only for protected HTTP outbox worker trigger
WORKER_SECRET=
# Supabase TLS uses the bundled certs/supabase-ca.crt for certificate verification.
# Server-only Supabase secret API key (sb_secret_...). NEVER put in browser code.
SUPABASE_SECRET_KEY=

# Trusted public frontend URL used in password recovery emails (HTTPS in production).
APP_URL=http://localhost:5173

# Manual UPI verification (configure the receiving account to match the QR)
UPI_VPA=
UPI_EVENT_NAME=Coding Club
# Optional; defaults to the organizer QR supplied under app/public/assets/payment.
UPI_QR_IMAGE_URL=
